# Copy to .env for local host-Python development (compose sets these itself).
FAWTARA_ENV=dev
FAWTARA_DATABASE_URL=postgresql+psycopg://fawtara_app:fawtara_app@localhost:5433/fawtara
FAWTARA_ADMIN_DATABASE_URL=postgresql+psycopg://fawtara:fawtara@localhost:5433/fawtara
FAWTARA_REDIS_URL=redis://localhost:6380/0
# Must be at least 32 bytes (HS256)
FAWTARA_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
